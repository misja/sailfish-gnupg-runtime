From 0b194515619f5bcccbeae9bea15946fc0cd29f27 Mon Sep 17 00:00:00 2001
From: misja <redacted@example.invalid>
Date: Tue, 13 Oct 2026 10:38:12 +0200
Subject: [PATCH] pinentry: require agent permission for external cache access

Default to no external cache access. Honor allow-external-password-cache and retain permission over RESET, as standard pinentry does. Gate both lookup and storage on permission plus the existing user setting. Legacy agents without this option retain native interaction but no longer use external persistent caching.
---
 plugins/gnupgplugin/pinentry/qassuanserver.cpp | 6 ++++--
 plugins/gnupgplugin/pinentry/qassuanserver.h   | 1 +
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/plugins/gnupgplugin/pinentry/qassuanserver.cpp b/plugins/gnupgplugin/pinentry/qassuanserver.cpp
index 21da163..e8abe1d 100644
--- a/plugins/gnupgplugin/pinentry/qassuanserver.cpp
+++ b/plugins/gnupgplugin/pinentry/qassuanserver.cpp
@@ -70,7 +70,8 @@ PinentryAssuanError _option_handler(assuan_context_t ctx, const char *key, const
     } else if (!strcmp(key, "default-pwmngr")) {
         return gpg_err_make(GPG_ERR_SOURCE_PINENTRY, GPG_ERR_NOT_IMPLEMENTED);
     } else if (!strcmp(key, "allow-external-password-cache") && !*value) {
-        return gpg_err_make(GPG_ERR_SOURCE_PINENTRY, GPG_ERR_UNKNOWN_OPTION);
+        self->m_externalCacheAllowed = true;
+        return 0;
     } else if (!strcmp(key, "invisible-char")) {
         return gpg_err_make(GPG_ERR_SOURCE_PINENTRY, GPG_ERR_NOT_IMPLEMENTED);
     } else
@@ -281,6 +282,7 @@ QAssuanServer::QAssuanServer(QObject *parent)
     , m_connected(false)
     , m_ctx(0)
     , m_request_stop(false)
+    , m_externalCacheAllowed(false)
 {
     gpg_error_t rc;
     int filedesc[2];
@@ -376,7 +378,7 @@ Sailfish::Secrets::Result QAssuanServer::requestPassphrase(QByteArray *passphras
     passphrase->clear();
     fromCache = false;
 
-    bool useCache = m_useCache->value(QVariant(true)).toBool();
+    bool useCache = m_externalCacheAllowed && m_useCache->value(QVariant(true)).toBool();
     if (useCache && cacheId.isValid() && prompt.instruction().isEmpty()) {
         Sailfish::Secrets::StoredSecretRequest request;
         qCDebug(lcSailfishPinentry) << "Starting cache request for" << cacheId.name();
diff --git a/plugins/gnupgplugin/pinentry/qassuanserver.h b/plugins/gnupgplugin/pinentry/qassuanserver.h
index cc1cb1e..1946167 100644
--- a/plugins/gnupgplugin/pinentry/qassuanserver.h
+++ b/plugins/gnupgplugin/pinentry/qassuanserver.h
@@ -59,6 +59,7 @@ class QAssuanServer: public QThread
     bool m_connected;
     assuan_context_t m_ctx;
     bool m_request_stop;
+    bool m_externalCacheAllowed;
 
     QString m_ctype;
     QString m_messages;
-- 
