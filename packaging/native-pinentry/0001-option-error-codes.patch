From 7a18593b273c68949edc1577faa5fb858ee56226 Mon Sep 17 00:00:00 2001
From: misja <redacted@example.invalid>
Date: Mon, 12 Oct 2026 21:57:22 +0200
Subject: [PATCH] pinentry: return source-qualified errors for optional agent
 options

Report unsupported no-grab as NOT_SUPPORTED and the unimplemented external-cache negotiation option as UNKNOWN_OPTION. Both are tolerated by modern agents; the PINENTRY source preserves their interpretation across legacy Assuan serialization. This does not change or establish external cache permission policy.
---
 plugins/gnupgplugin/pinentry/qassuanserver.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/plugins/gnupgplugin/pinentry/qassuanserver.cpp b/plugins/gnupgplugin/pinentry/qassuanserver.cpp
index b86b6d7..ef5d5eb 100644
--- a/plugins/gnupgplugin/pinentry/qassuanserver.cpp
+++ b/plugins/gnupgplugin/pinentry/qassuanserver.cpp
@@ -37,7 +37,7 @@ gpg_error_t _option_handler(assuan_context_t ctx, const char *key, const char *v
     QAssuanServer *self = static_cast<QAssuanServer*>(assuan_get_pointer(ctx));
 
     if (!strcmp(key, "no-grab") && !*value) {
-        return ASSUAN_Not_Implemented;
+        return gpg_err_make(GPG_ERR_SOURCE_PINENTRY, GPG_ERR_NOT_SUPPORTED);
     } else if (!strcmp(key, "grab") && !*value) {
         return 0; // Silently ignore.
     } else if (!strcmp(key, "debug-wait")) {
@@ -65,7 +65,7 @@ gpg_error_t _option_handler(assuan_context_t ctx, const char *key, const char *v
     } else if (!strcmp(key, "default-pwmngr")) {
         return ASSUAN_Not_Implemented;
     } else if (!strcmp(key, "allow-external-password-cache") && !*value) {
-        return ASSUAN_Not_Implemented;
+        return gpg_err_make(GPG_ERR_SOURCE_PINENTRY, GPG_ERR_UNKNOWN_OPTION);
     } else if (!strcmp(key, "invisible-char")) {
         return ASSUAN_Not_Implemented;
     } else
