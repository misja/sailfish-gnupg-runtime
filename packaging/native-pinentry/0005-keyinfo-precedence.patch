From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Misja Hoebe <36168+misja@users.noreply.github.com>
Date: Wed, 14 Oct 2026 20:52:29 +0200
Subject: [PATCH] pinentry: preserve explicit key information over descriptions

Use the legacy description-derived identifier only before SETKEYINFO. An explicit empty identifier or --clear remains authoritative, and RESET clears identifier authority for the next request. Preserve the existing legacy description parser without claiming it is collision-safe.

diff --git a/plugins/gnupgplugin/pinentry/qassuanserver.cpp b/plugins/gnupgplugin/pinentry/qassuanserver.cpp
index e8abe1d..4c9e92f 100644
--- a/plugins/gnupgplugin/pinentry/qassuanserver.cpp
+++ b/plugins/gnupgplugin/pinentry/qassuanserver.cpp
@@ -29,6 +29,7 @@ void _reset_handler(assuan_context_t ctx)
     QAssuanServer *self = static_cast<QAssuanServer*>(assuan_get_pointer(ctx));
 
     self->cacheId.setName(QString());
+    self->m_keyInfoSet = false;
     self->prompt = Sailfish::Secrets::InteractionParameters::PromptText();
 #if PINENTRY_MODERN_ASSUAN
     Q_UNUSED(line);
@@ -85,11 +86,12 @@ PinentryAssuanError _assuan_cmd_setdesc(assuan_context_t ctx, char *line)
     QAssuanServer *self = static_cast<QAssuanServer*>(assuan_get_pointer(ctx));
     self->prompt.setMessage(QByteArray::fromPercentEncoding(line).simplified());
 
-    // Ugly hack here due to GnuPG being stuck in 2.0.4
-    // and not having SETKEYINFO command yet. Description looks like:
+    // Legacy agents without SETKEYINFO expose the key ID in the description.
+    // An explicit identifier (including --clear) must take precedence.
+    // Description looks like:
     // "user: "John Dow <john.dow@example.org>""
     // "2048-bit RSA key, ID A099539B, created 2018-04-13 (main key ID 41123AA4)"
-    {
+    if (!self->m_keyInfoSet) {
         const QString &str(self->prompt.message());
         int id = str.lastIndexOf(", ID ");
         if (id > 0) {
@@ -153,6 +155,7 @@ PinentryAssuanError _assuan_cmd_setkeyinfo(assuan_context_t ctx, char *line)
 {
     qCDebug(lcSailfishPinentry) << __func__ << line;
     QAssuanServer *self = static_cast<QAssuanServer*>(assuan_get_pointer(ctx));
+    self->m_keyInfoSet = true;
     self->cacheId.setName((*line && strcmp(line, "--clear") !=0) ? line : QString());
 
     return 0;
@@ -283,6 +286,7 @@ QAssuanServer::QAssuanServer(QObject *parent)
     , m_ctx(0)
     , m_request_stop(false)
     , m_externalCacheAllowed(false)
+    , m_keyInfoSet(false)
 {
     gpg_error_t rc;
     int filedesc[2];
diff --git a/plugins/gnupgplugin/pinentry/qassuanserver.h b/plugins/gnupgplugin/pinentry/qassuanserver.h
index 1946167..893a6e5 100644
--- a/plugins/gnupgplugin/pinentry/qassuanserver.h
+++ b/plugins/gnupgplugin/pinentry/qassuanserver.h
@@ -60,6 +60,7 @@ class QAssuanServer: public QThread
     assuan_context_t m_ctx;
     bool m_request_stop;
     bool m_externalCacheAllowed;
+    bool m_keyInfoSet;
 
     QString m_ctype;
     QString m_messages;
