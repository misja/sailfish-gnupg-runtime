#!/usr/bin/busybox sh
set -eu
PATH=/usr/bin:/bin
export PATH
unset BASH_ENV ENV CDPATH LD_LIBRARY_PATH LD_PRELOAD LD_AUDIT GPG_AGENT_INFO
# All installed paths are fixed; caller Python configuration is discarded.
exec /usr/bin/env -i PATH=/usr/bin:/bin \
    SAILFISH_GNUPGHOME="${SAILFISH_GNUPGHOME:-}" \
    LANG="${LANG:-C}" LC_ALL="${LC_ALL:-}" TERM="${TERM:-dumb}" \
    GPG_TTY="${GPG_TTY:-}" \
    /usr/bin/python3 -I -B /usr/libexec/sailfish-gnupg/libexec/lifecycle-entry.py gpg "$@"
