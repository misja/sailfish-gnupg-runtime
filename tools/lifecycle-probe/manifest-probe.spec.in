%global private_prefix /usr/libexec/sailfish-gnupg
%global debug_package %{nil}
# Deliberate postprocessing mutation proves manifest-hook ordering.
%global probe_previous_install_post %{expand:%{__os_install_post}}
%define __os_install_post %{probe_previous_install_post}\
printf after-postprocessing > %{buildroot}%{private_prefix}/libexec/postprocess-fixture\

@REAL_HOOK@
Name: sailfish-lifecycle-manifest-probe
Version: 1
Release: 1
Summary: Inert SDK payload-manifest ordering probe
License: GPL-3.0-or-later
%description
Inert fixture for manifest generation after RPM payload postprocessing.
%prep
mkdir -p runtime tools
cp %{_sourcedir}/runtime/lifecycle_admission.py %{_sourcedir}/runtime/lifecycle_control.py runtime/
cp %{_sourcedir}/tools/build-payload-manifest.py tools/
%build
gcc -g %{_sourcedir}/probe.c -o probe
%install
install -d %{buildroot}%{private_prefix}/bin %{buildroot}%{private_prefix}/libexec %{buildroot}/usr/bin
install -m 0755 probe %{buildroot}%{private_prefix}/bin/probe
install -m 0644 %{_sourcedir}/runtime/*.py %{buildroot}%{private_prefix}/libexec/
install -m 0644 %{_sourcedir}/runtime/runtime-policy.sh %{buildroot}%{private_prefix}/libexec/
install -m 0755 %{_sourcedir}/runtime/gpg-operation %{_sourcedir}/runtime/agent-operation %{buildroot}%{private_prefix}/libexec/
install -m 0755 %{_sourcedir}/runtime/sailfish-gpg %{_sourcedir}/runtime/sailfish-gpg-agent %{buildroot}/usr/bin/
printf before-postprocessing > %{buildroot}%{private_prefix}/libexec/postprocess-fixture
%files
%defattr(-,root,root,-)
%{private_prefix}
/usr/bin/sailfish-gpg
/usr/bin/sailfish-gpg-agent
